{
  "name": "argus-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/keep-dist.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:layout": "esbuild src/lib/graphLayout.check.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/argus-layout-check.cjs --log-level=error && node node_modules/.cache/argus-layout-check.cjs",
    "test": "tsc --noEmit && npm run check:layout"
  },
  "dependencies": {
    "@tanstack/react-query": "5.62.7",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "^0.25.12",
    "typescript": "5.7.2",
    "vite": "6.4.4"
  }
}
