# Copy to .env and adjust. Every variable here is optional: argusd starts with
# working defaults and the sample catalog.

# ---- HTTP ----
ARGUS_ADDR=:8080
ARGUS_REQUEST_TIMEOUT=30s
ARGUS_SHUTDOWN_TIMEOUT=20s

# ---- Logging ----
# debug | info | warn | error
ARGUS_LOG_LEVEL=info
# text | json
ARGUS_LOG_FORMAT=text

# ---- Service catalog ----
ARGUS_CATALOG_PATH=configs/services.yaml
# Reload the catalog on this interval; 0 or unset disables periodic reloads
# (POST /api/v1/catalog/refresh always works).
ARGUS_CATALOG_REFRESH=0

# ---- Investigation engine ----
# auto      - Claude when credentials are present, heuristic otherwise
# claude    - the model-driven agent (fails fast without credentials)
# heuristic - the deterministic graph heuristic, no network calls
ARGUS_ENGINE=auto
ARGUS_INVESTIGATION_TIMEOUT=5m

# ---- Claude ----
ANTHROPIC_API_KEY=
ARGUS_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ARGUS_EFFORT=high
ARGUS_MAX_TOKENS=16000
# The real cost control: how many turns of the tool-use loop one
# investigation may take.
ARGUS_MAX_ITERATIONS=12

# ---- Telemetry ----
# The synthetic provider, so the platform runs end to end before Prometheus,
# Loki, Tempo and a deploy tracker are wired up. Turn it off in anything real.
ARGUS_DEMO_TELEMETRY=true
ARGUS_DEMO_FAULTY_SERVICE=postgres-main
